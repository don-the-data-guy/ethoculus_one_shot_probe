OPENAI_API_KEY=
TARGET_MODEL=gpt-5.6-luna
ORCHESTRATOR_MODEL=gpt-5.6-luna
INPUT_USD_PER_MTOK=0.20
OUTPUT_USD_PER_MTOK=1.20
ETHOCULUS_TRIALS=2
JUDGE_MODEL=gpt-5.6-luna
CITATION_VERIFY_TIMEOUT=15

# Agent probes (ETH-003). See docs/claude_agent_guide.md
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (HTTP 400 asking for anthropic-workspace-id)
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TURNS=8
AGENT_MAX_TOKENS=1024
# Optional, for a cost estimate in the report (USD per million tokens, from the current pricing page)
AGENT_INPUT_USD_PER_MTOK=
AGENT_OUTPUT_USD_PER_MTOK=
# Optional judge for --judge. Use a different platform than the agent.
JUDGE_PROVIDER=openai
